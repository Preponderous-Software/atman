# Writes OUT, a C++ source with every codex entry (content/codex/*.json, in
# file-name order) and its plate (content/plates/<id>.png) built in, so the
# game needs no files beside it. Run with cmake -P, given SOURCE_DIR and OUT.
file(GLOB entries "${SOURCE_DIR}/content/codex/*.json")
list(SORT entries)

string(REPEAT "[0-9a-f]" 64 row)
set(plates "")
set(table "")
set(i 0)
foreach(path IN LISTS entries)
  file(READ "${path}" json)
  string(JSON id GET "${json}" id)
  string(JSON menu GET "${json}" menu)
  string(JSON unlock GET "${json}" unlock)
  set(png "${SOURCE_DIR}/content/plates/${id}.png")
  if(NOT EXISTS "${png}")
    message(FATAL_ERROR "codex entry ${id} has no plate; run tools/plates/make_plates.py")
  endif()
  file(READ "${png}" hex HEX)
  string(REGEX REPLACE "(${row})" "\\1\n" hex "${hex}")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(APPEND plates "const unsigned char kPlate${i}[] = {\n${hex}\n};\n")
  if(unlock STREQUAL "always")
    set(open "true, CodexId::Count")
  else()
    set(open "false, CodexId::${unlock}")
  endif()
  string(APPEND table "    {\"${id}\", \"${menu}\", ${open}, kPlate${i}, sizeof kPlate${i}},\n")
  math(EXPR i "${i} + 1")
endforeach()

set(text "// Generated by cmake/embed_codex.cmake from content/codex and content/plates. Do not edit.
#include \"codex/codex.h\"

namespace atman::codex {

namespace {
${plates}
}  // namespace

const Entry kEntries[] = {
${table}};
const int kEntryCount = ${i};

}  // namespace atman::codex
")
# Only touch the file when it changes, so nothing rebuilds needlessly.
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
